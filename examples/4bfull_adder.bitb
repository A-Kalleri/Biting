;First program in bitting-bitter (21/08/2026)
;A 4-bit full adder

; The number 5
1 > x0. ;lsb
0 > x1.
1 > x2.
0 > x3. ;msb

; The number 1
1 > x4. ;lsb
0 > x5.
0 > x6.
0 > x7. ;msb

;------------
x0 ^ x4 > x8.
x0 & x4 > x9.

0 ^ x8 > x10. ;sum

x8 & 0 > x11.
x11 | x9 > x12. ;carry

;------------
x1 ^ x5 > x13.
x1 & x5 > x14.

x12 ^ x13 > x15. ;sum

x13 & x12 > x16.
x16 | x14 > x17. ;carry

;------------
x2 ^ x6 > x18.
x2 & x6 > x19.

x17 ^ x18 > x20. ;sum

x17 & x18 > x21.
x21 | x19 > x22. ;carry

;------------
x3 ^ x7 > x23.
x3 & x7 > x24.

x22 ^ x23 > x25. ;sum

x22 & x23 > x26.
x26 | x24 > x27. ;carry

;------------

;carry
x27<.    ;lsb

x25<.
x20<.
x15<.
x10<.   ;msb